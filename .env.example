# Copy this file to .env and fill in real values locally.
# .env is gitignored - never commit actual secrets.
#
# Format: KEY=value, no quotes and no spaces around '='. docker/podman
# --env-file (used by ./scripts/run.sh) passes quotes through literally.
# A line with an empty value still SETS the variable (to ""); comment out
# anything you don't use instead of leaving it empty.
# Check the result with: python -m agent.doctor

# --- Required -------------------------------------------------------------

# API key for the LLM endpoint (any OpenAI-compatible API).
ACCESS_TOKEN=

# --- Optional features ------------------------------------------------------

# web_search tool (Tavily). Free key at https://tavily.com.
# TAVILY_API_KEY=tvly-...

# Notion MCP server: internal integration token (notion.so/my-integrations).
# NOTION_TOKEN=ntn_...

# Gmail MCP server: only allow mail (send_email/create_draft) to these
# recipients - comma-separated addresses and/or @domains.
# GMAIL_ALLOWED_RECIPIENTS=you@example.com,@example.org

# Gmail MCP server: where the OAuth files are. Leave these commented out for
# ./scripts/run.sh and docker run - the container reads /gmail/credentials.json
# and /gmail/gmail-token.json, mounted from .secrets/gmail/. Set them (absolute
# paths) only when running the agent directly on the host. An empty value here
# breaks Gmail inside the container.
# GMAIL_CREDENTIALS_PATH=/absolute/path/to/.secrets/gmail/credentials.json
# GMAIL_TOKEN_PATH=/absolute/path/to/.secrets/gmail/gmail-token.json

# Remote execution (sandbox_exec): the private key CONTENT, base64 on one
# line - not a file path. Only used when the config has a 'sandbox' block.
#   base64 < sandbox_key | tr -d '\n'
# SANDBOX_SSH_KEY=<base64 of the private key file>

# Grafana admin password for editing the dashboard (./scripts/run.sh only).
# Viewing needs no login. Grafana's default is admin/admin.
# GRAFANA_ADMIN_PASSWORD=

# --- Alternatives (rarely needed) ---------------------------------------------

# Other names for the LLM key; if several are set, LLM_API_KEY wins,
# then OPENAI_API_KEY, then ACCESS_TOKEN.
# LLM_API_KEY=
# OPENAI_API_KEY=

# A different OpenAI-compatible endpoint (a 'base_url' in the config file wins).
# Defaults to https://api.openai.com/v1.
# LLM_BASE_URL=https://llm.example.org/v1
